# The host packages in peerDependencies are provided by pi/omp at runtime, not
# by npm. Without this, `npm install` resolves every "*" peer from the registry
# and pulls the entire pi dependency tree — 266 packages including the AWS SDK,
# protobufjs and openai — just to install a YAML parser for the build.
#
# `legacy-peer-deps` skips that resolution. It is also what npm would do anyway
# for a consumer installing this package: pi installs it with peer auto-install
# suppressed (see pi.dev/docs/latest/packages).
legacy-peer-deps=true
